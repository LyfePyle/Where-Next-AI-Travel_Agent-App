{
  "name": "where-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:api": "node test-comprehensive-apis.js",
    "test:booking": "node test-booking-flow.js",
    "test:performance": "node test-performance.js",
    "test:openai": "node test-openai-api.js",
    "seed:addons": "node scripts/seed-addons.js",
    "test:amadeus": "node test-amadeus-simple.js",
    "test:database": "node scripts/test-database.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:critical": "node test-critical-systems.js",
    "test:ai-integration": "jest __tests__/api/ai-integration.test.ts",
    "test:payment-flow": "jest __tests__/api/payment-flow.test.ts",
    "test:amadeus-integration": "jest __tests__/api/amadeus-integration.test.ts",
    "test:database-ops": "jest __tests__/api/database-operations.test.ts",
    "test:performance-benchmarks": "jest __tests__/performance/performance-benchmarks.test.ts --testTimeout=60000",
    "test:mobile-responsive": "playwright test __tests__/e2e/mobile-responsive.spec.ts",
    "test:error-handling": "jest __tests__/resilience/error-handling.test.ts --testTimeout=30000",
    "test:security": "jest __tests__/security/security-validation.test.ts --testTimeout=30000",
    "test:cross-browser": "playwright test __tests__/e2e/cross-browser.spec.ts",
    "test:accessibility": "playwright test __tests__/accessibility/accessibility.spec.ts",
    "test:seo": "playwright test __tests__/seo/seo-testing.spec.ts",
    "test:analytics": "playwright test __tests__/analytics/analytics-tracking.spec.ts",
    "test:comprehensive": "node test-comprehensive-suite.js",
    "test:all": "npm run test && npm run test:api && npm run test:performance && npm run test:database",
    "test:all-critical": "npm run test:critical && npm run test:e2e",
    "test:full-suite": "npm run test:comprehensive && npm run test:critical",
    "setup:database": "echo 'Please run the SQL from supabase/sql/2025-setup.sql in your Supabase dashboard'",
    "seed:database": "node scripts/seed-database.js"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@stripe/react-stripe-js": "^2.9.0",
    "@stripe/stripe-js": "^3.0.10",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.58.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/uuid": "^10.0.0",
    "amadeus": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.2.1",
    "lucide-react": "^0.540.0",
    "next": "15.4.6",
    "node-fetch": "^3.3.2",
    "openai": "^5.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "sonner": "^2.0.3",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.21",
    "axe-playwright": "^2.2.2",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "playwright": "^1.55.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5"
  }
}
