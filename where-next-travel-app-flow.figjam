{
  "document": {
    "id": "where-next-travel-flow",
    "name": "Where Next AI Travel App - User Flow",
    "type": "FIGJAM",
    "children": [
      {
        "id": "homepage",
        "name": "Homepage",
        "type": "FRAME",
        "x": 100,
        "y": 100,
        "width": 300,
        "height": 200,
        "fills": [{"type": "SOLID", "color": {"r": 0.2, "g": 0.6, "b": 1, "a": 1}}],
        "children": [
          {
            "type": "TEXT",
            "characters": "🏠 HOMEPAGE\n\n• Hero section\n• Quick trip planner\n• Featured destinations\n• AI travel agent intro",
            "fontSize": 14,
            "fontName": {"family": "Inter", "style": "Regular"}
          }
        ]
      },
      {
        "id": "plan-trip",
        "name": "Plan Trip",
        "type": "FRAME",
        "x": 500,
        "y": 100,
        "width": 300,
        "height": 250,
        "fills": [{"type": "SOLID", "color": {"r": 0.1, "g": 0.7, "b": 0.3, "a": 1}}],
        "children": [
          {
            "type": "TEXT",
            "characters": "✈️ TRIP PLANNER\n\n• Origin airport\n• Date range picker\n• Budget breakdown:\n  - Daily spending\n  - Flight budget\n  - Hotel budget\n• Party size (adults/kids)\n• Vibes selection\n• Max flight time\n• Budget style (budget/comfort/luxury)",
            "fontSize": 14,
            "fontName": {"family": "Inter", "style": "Regular"}
          }
        ]
      },
      {
        "id": "ai-suggestions",
        "name": "AI Suggestions",
        "type": "FRAME",
        "x": 900,
        "y": 100,
        "width": 300,
        "height": 250,
        "fills": [{"type": "SOLID", "color": {"r": 0.8, "g": 0.2, "b": 0.8, "a": 1}}],
        "children": [
          {
            "type": "TEXT",
            "characters": "🤖 AI SUGGESTIONS\n\n• 3 AI-generated destinations\n• Realistic pricing\n• Weather & crowd info\n• Highlights & attractions\n• Fit score\n• 'See Details' buttons\n• Data source indicator",
            "fontSize": 14,
            "fontName": {"family": "Inter", "style": "Regular"}
          }
        ]
      },
      {
        "id": "trip-details",
        "name": "Trip Details",
        "type": "FRAME",
        "x": 1300,
        "y": 100,
        "width": 300,
        "height": 300,
        "fills": [{"type": "SOLID", "color": {"r": 1, "g": 0.5, "b": 0.2, "a": 1}}],
        "children": [
          {
            "type": "TEXT",
            "characters": "📋 TRIP DETAILS\n\n• Destination overview\n• Daily itinerary\n• Flight options\n• Hotel options\n• Budget calculator\n• Trip cost summary\n• 'Buy Complete Trip' button\n• Individual booking options",
            "fontSize": 14,
            "fontName": {"family": "Inter", "style": "Regular"}
          }
        ]
      },
